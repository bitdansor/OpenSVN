# Assistant/agent scratch data for this repository
.workbuddy/

# Internal planning, execution and design notes — kept locally, never published
# Leading slash: only the repository-root directory, so a future
# `Sources/.../internal/` directory is never caught by this rule.
# Internal planning, execution and design notes — kept locally, never published
# Leading slash: only the repository-root directory, so a future
# `Sources/.../internal/` directory is never caught by this rule.
/internal/

# Editor state — one person's run configurations, not the project's
# `/` anchored like `/internal/` above: only the root workspace file, so a future
# `Sources/.../.vscode/` is not swallowed. Note that an ignore rule cannot untrack
# a file git already follows — `git rm --cached` is the other half.
/.vscode/
