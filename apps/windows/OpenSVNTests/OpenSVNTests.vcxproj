<?xml version="1.0" encoding="utf-8"?>
<!--
  Contract tests for the Windows implementation.

  A console app on purpose: the model and parser must be testable without a
  desktop session, so CI can run them on a headless runner. The test project
  compiles the portable sources directly instead of referencing the WinUI app
  project — a packaged app project is not linkable from a console test, and
  duplicating the compile is cheaper than adding a third "core" project before
  there is a second consumer.

  Dependencies come from vcpkg manifest mode (../vcpkg.json).
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{0AC34523-672F-55F7-868A-6603291CBADA}</ProjectGuid>
    <ProjectName>OpenSVNTests</ProjectName>
    <RootNamespace>OpenSVNTests</RootNamespace>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <!-- ../vcpkg.json; the app project does not use vcpkg at all. -->
    <VcpkgManifestRoot>$(ProjectDir)..</VcpkgManifestRoot>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <LanguageStandard>stdcpp20</LanguageStandard>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.22000.0</WindowsTargetPlatformMinVersion>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- ../OpenSVN is the include root, so shared headers keep their
           "Models/…", "Services/…" paths in both projects. -->
      <AdditionalIncludeDirectories>$(ProjectDir)..\OpenSVN;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="SVNModelsTests.cpp" />
    <ClCompile Include="..\OpenSVN\Models\SVNModels.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
