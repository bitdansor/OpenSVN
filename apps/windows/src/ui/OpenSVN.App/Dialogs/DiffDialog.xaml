<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OpenSVN.App.Dialogs.DiffDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenSVN.App.Controls"
    PrimaryButtonText=""
    SecondaryButtonText="复制"
    CloseButtonText="关闭"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">620</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1160</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="8" MinWidth="600" MinHeight="320" MaxHeight="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <Border Grid.Row="1" CornerRadius="6" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <controls:DiffView x:Name="Diff" />
        </Border>
    </Grid>
</ContentDialog>
