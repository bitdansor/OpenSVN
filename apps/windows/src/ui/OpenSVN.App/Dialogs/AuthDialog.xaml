<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OpenSVN.App.Dialogs.AuthDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="需要认证"
    PrimaryButtonText="登录"
    CloseButtonText="取消"
    DefaultButton="Primary"
    MinWidth="460">

    <StackPanel Spacing="10">
        <TextBlock x:Name="HostText" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="UrlText" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   IsTextSelectionEnabled="True" />
        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   Text="凭据只保存在 Windows 凭据管理器；密码通过 stdin 传给 svn，不会出现在命令行参数、日志或设置中。" />
        <TextBox x:Name="UsernameBox" Header="用户名" PlaceholderText="用户名" />
        <PasswordBox x:Name="PasswordBox" Header="密码" PlaceholderText="密码"
                     PasswordRevealMode="Peek" />
        <TextBlock x:Name="ErrorText" FontSize="12"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
