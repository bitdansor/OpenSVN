<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OpenSVN.App.Dialogs.CommitDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OpenSVN.App.Models"
    xmlns:controls="using:OpenSVN.App.Controls"
    Title="提交"
    PrimaryButtonText="提交"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">620</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <DataTemplate x:Key="CommitItemTemplate" x:DataType="models:StatusItem">
            <Grid Padding="4,5" ColumnSpacing="8">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="复制完整路径" Tag="{x:Bind Path}"
                                        Click="CopyPath_Click" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="22" Height="22" CornerRadius="4"
                        Background="{x:Bind BadgeColor, Converter={StaticResource StringToBrush}}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Badge}" Foreground="White" FontSize="11"
                               FontWeight="SemiBold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{x:Bind DisplayPath}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind Path}"
                           AutomationProperties.Name="{x:Bind Path}" />
                <TextBlock Grid.Column="2" Text="{x:Bind ItemLabel}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid MinWidth="600" MinHeight="380" MaxHeight="560" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="ConflictBanner" Severity="Warning" IsClosable="False"
                 Title="存在未解决的冲突"
                 Message="冲突文件不会出现在可提交列表中；即使提交其他文件，svn 仍可能拒绝本次提交。" />

        <InfoBar x:Name="ErrorBar" Grid.Row="1" Severity="Error" IsOpen="False"
                 IsClosable="True" Title="提交失败" Message="" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="240" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <ListView x:Name="PathsList" SelectionMode="Multiple"
                              IsMultiSelectCheckBoxEnabled="True"
                              ItemTemplate="{StaticResource CommitItemTemplate}"
                              SelectionChanged="PathsList_SelectionChanged" />
                    <TextBlock x:Name="NoPathsText" Text="没有选中的可提交路径"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox x:Name="MessageBox" Header="提交说明" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="96" MaxHeight="150"
                         PlaceholderText="说明这次提交做了什么" TextChanged="MessageBox_TextChanged" />
                <ComboBox x:Name="RecentBox" Grid.Row="1" Header="最近说明"
                          PlaceholderText="（没有最近说明）"
                          HorizontalAlignment="Stretch" SelectionChanged="Recent_SelectionChanged" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <TextBlock x:Name="PreviewLabel" Text="差异预览" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <ProgressRing x:Name="PreviewRing" Width="16" Height="16" IsActive="False"
                                  Visibility="Collapsed"
                                  AutomationProperties.Name="正在加载差异预览" />
                </StackPanel>
                <Border Grid.Row="3" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <controls:DiffView x:Name="PreviewDiff" />
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" x:Name="BusyPanel" Orientation="Horizontal" Spacing="8"
                    Visibility="Collapsed" Margin="0,4,0,0">
            <ProgressRing IsActive="True" Width="16" Height="16" />
            <TextBlock Text="正在提交…" VerticalAlignment="Center" />
            <Button Content="取消当前操作" Click="CancelCommit_Click" />
        </StackPanel>

        <Border Grid.Row="3" x:Name="AuthPanel" Visibility="Collapsed"
                CornerRadius="6" BorderThickness="1"
                BorderBrush="{ThemeResource SystemFillColorCautionBrush}" Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="需要认证" FontWeight="SemiBold" />
                <TextBlock x:Name="AuthHostText" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UsernameBox" Header="用户名" />
                    <PasswordBox x:Name="PasswordBox" Grid.Column="1" Header="密码"
                                 PasswordRevealMode="Peek" />
                    <Button Grid.Column="2" Content="登录并重试" VerticalAlignment="Bottom"
                            Click="AuthRetry_Click" />
                </Grid>
                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="凭据保存在 Windows 凭据管理器；密码通过 stdin 传给 svn。提交说明与勾选会保留。" />
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
