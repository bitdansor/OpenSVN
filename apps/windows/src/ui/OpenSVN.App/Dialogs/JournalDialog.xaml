<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OpenSVN.App.Dialogs.JournalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OpenSVN.App.Models"
    Title="未完成的操作"
    PrimaryButtonText="全部忽略"
    CloseButtonText="关闭"
    DefaultButton="Close"
    MinWidth="560">

    <ContentDialog.Resources>
        <DataTemplate x:Key="JournalEntryTemplate" x:DataType="models:JournalEntryDto">
            <Border CornerRadius="6" BorderThickness="1" Padding="12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Margin="0,0,0,6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Summary}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind MetaDisplay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind RecoveryAdvice}" FontSize="12"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="忽略此记录" VerticalAlignment="Top"
                            Padding="10,3" FontSize="12" Tag="{x:Bind Id}" Click="DiscardOne_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid RowSpacing="8" MinHeight="300" MaxHeight="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
            <TextBlock Text="启动时仍然存在的记录，按定义就是上次没有结果的操作。OpenSVN 不会自动重试；请先刷新确认工作副本状态，再决定是否忽略。"
                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="ExtraText" Grid.Row="1" FontSize="12"
                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
        <Grid Grid.Row="2">
            <ListView x:Name="EntryList" ItemsSource="{x:Bind Entries}" SelectionMode="None"
                      ItemTemplate="{StaticResource JournalEntryTemplate}" />
            <TextBlock x:Name="EmptyText" Text="没有未完成的操作记录。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</ContentDialog>
