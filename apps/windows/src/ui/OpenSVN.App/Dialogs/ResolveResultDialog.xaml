<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OpenSVN.App.Dialogs.ResolveResultDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="关闭"
    DefaultButton="Close"
    MinWidth="620">

    <StackPanel Spacing="10">
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
        <StackPanel x:Name="BackupPanel" Spacing="6" Visibility="Collapsed">
            <TextBlock Text="冲突备份" FontWeight="SemiBold" />
            <TextBlock x:Name="BackupPath" FontSize="12"
                       FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap"
                       IsTextSelectionEnabled="True" />
        </StackPanel>
        <StackPanel x:Name="ResidualPanel" Spacing="6" Visibility="Collapsed">
            <TextBlock x:Name="ResidualTitle" FontWeight="SemiBold"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" />
            <StackPanel x:Name="ResidualList" Spacing="2" />
            <TextBlock Text="直接提交会把冲突标记写进仓库。" FontSize="12"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>
        <TextBlock x:Name="SkippedText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
