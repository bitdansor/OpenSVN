<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OpenSVN.App.Dialogs.TaskCenterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:OpenSVN.App.Services"
    Title="任务"
    PrimaryButtonText="清除已完成"
    CloseButtonText="关闭"
    DefaultButton="Close"
    MinWidth="560">

    <ContentDialog.Resources>
        <DataTemplate x:Key="TaskTemplate" x:DataType="services:TaskRecord">
            <Border CornerRadius="6" BorderThickness="1" Padding="12" Margin="0,0,0,6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind TimeDisplay, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="12"
                                   TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Error, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap" MaxLines="3"
                                   Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{x:Bind Identifier, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="重试" VerticalAlignment="Top" Padding="10,3"
                            FontSize="12" Click="Retry_Click"
                            Visibility="{x:Bind IsRetryVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid RowSpacing="8" MinHeight="320" MaxHeight="540">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="任务完成后不会自动消失；成功条目没有可重放的内容。超时、网络中断或未分类失败时结果可能未知，请先刷新确认，界面不会提供直接重试。"
                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="取消当前操作" Click="CancelCurrent_Click" />
        </Grid>
        <Grid Grid.Row="1">
           <ListView x:Name="TaskList" SelectionMode="None"
                      ItemTemplate="{StaticResource TaskTemplate}" />
            <TextBlock x:Name="EmptyText" Text="还没有任务。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Grid.Row="2" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="取消只对正在运行的任务生效；重试不会绕过服务层的确认参数，也不会自动重试。" />
    </Grid>
</ContentDialog>
