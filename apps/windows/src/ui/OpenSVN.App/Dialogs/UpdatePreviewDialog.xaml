<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OpenSVN.App.Dialogs.UpdatePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OpenSVN.App.Models"
    Title="更新预览"
    PrimaryButtonText="更新"
    CloseButtonText="取消"
    DefaultButton="Primary"
    MinWidth="620">

    <ContentDialog.Resources>
        <DataTemplate x:Key="RemoteChangeTemplate" x:DataType="models:RemoteChangeDto">
            <Grid Padding="4,5" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ItemDisplay}" FontSize="12"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Path}"
                               AutomationProperties.Name="{x:Bind Path}" />
                    <TextBlock Text="{x:Bind LocalDisplay}" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind RiskText}" FontSize="12"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid RowSpacing="8" MinHeight="300" MaxHeight="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="3">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="SubSummaryText" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="1" FontSize="12"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
        <Grid Grid.Row="2">
            <ListView x:Name="ChangesList" ItemTemplate="{StaticResource RemoteChangeTemplate}"
                      SelectionMode="None" />
            <TextBlock x:Name="EmptyText" Text="已是最新，没有远端变更。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
        <TextBlock Grid.Row="3" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="预览只按路径级别提示「可能冲突」；是否真的冲突取决于内容。预检失败不会阻止更新。" />
    </Grid>
</ContentDialog>
