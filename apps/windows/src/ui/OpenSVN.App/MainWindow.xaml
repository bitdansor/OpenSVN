<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenSVN.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:OpenSVN.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenSVN">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.Resources>
        <DataTemplate x:Key="RecentWorkingCopyTemplate" x:DataType="viewModels:RecentWorkingCopyItem">
            <Grid Padding="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="1">
                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Path}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Path}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind StatusText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="14,0,150,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/opensvn-icon-small.png"
                       Width="16" Height="16" Stretch="Uniform" />
                <TextBlock Text="OpenSVN" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="{x:Bind ViewModel.WorkingCopyName, Mode=OneWay}"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.WorkingCopyPath, Mode=OneWay}"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"
                           ToolTipService.ToolTip="{x:Bind ViewModel.WorkingCopyPath, Mode=OneWay}"
                           AutomationProperties.Name="{x:Bind ViewModel.WorkingCopyPath, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ViewModel.ConnectionTooltip, Mode=OneWay}">
                <Ellipse Width="8" Height="8"
                         Fill="{Binding ConnectionColor, Converter={StaticResource StringToBrush}}" />
                <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="NotificationBar" Grid.Row="1" Margin="12,0,12,8"
                 IsOpen="False" IsClosable="True" Severity="Informational"
                 Title="" Message="">
            <InfoBar.ActionButton>
                <Button x:Name="NotificationActionButton" Content="查看" Visibility="Collapsed"
                        Click="NotificationAction_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2">
            <Grid x:Name="WelcomeRoot">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="620" Spacing="16" Margin="32">
                        <Image Source="ms-appx:///Assets/opensvn-icon.png"
                               Width="96" Height="96" HorizontalAlignment="Center" />
                        <TextBlock Text="OpenSVN" FontSize="34" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="原生 Subversion 客户端" FontSize="15"
                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="选择一个工作副本，或从仓库检出。危险写入会先确认，失败时会给出可操作的说明。"
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="WelcomeActions" Orientation="Horizontal" Spacing="12"
                                    HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="打开工作副本" Style="{StaticResource AccentButtonStyle}"
                                    Click="OpenWorkingCopy_Click"
                                    IsEnabled="{x:Bind ViewModel.HasSvn, Mode=OneWay}" />
                            <Button Content="检出仓库…" Click="Checkout_Click"
                                    IsEnabled="{x:Bind ViewModel.HasSvn, Mode=OneWay}" />
                            <Button Content="设置 svn 路径…" Click="WelcomeSettings_Click" />
                        </StackPanel>
                        <StackPanel Spacing="4"
                                    Visibility="{Binding HasRecentWorkingCopies, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="最近打开" FontWeight="SemiBold" FontSize="12" />
                            <ListView ItemsSource="{x:Bind ViewModel.RecentWorkingCopies, Mode=OneWay}"
                                      ItemTemplate="{StaticResource RecentWorkingCopyTemplate}"
                                      SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="RecentWorkingCopy_Click"
                                      MaxHeight="220"
                                      AutomationProperties.Name="最近打开的工作副本" />
                        </StackPanel>
                        <InfoBar x:Name="WelcomeError" IsOpen="{x:Bind ViewModel.HasInitializationError, Mode=OneWay}"
                                 Severity="Error" IsClosable="False" Title="SVN 服务不可用"
                                 Message="{x:Bind ViewModel.InitializationError, Mode=OneWay}" />
                        <StackPanel Spacing="4" Margin="0,12,0,0">
                            <TextBlock Text="{x:Bind ViewModel.InstallationSummary, Mode=OneWay}"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="密码只保存在 Windows 凭据管理器；它通过 stdin 传给 svn，不会出现在命令行参数、日志或设置中。"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <ProgressRing IsActive="True" Width="18" Height="18" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentTaskDetail, Mode=OneWay}"
                                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="取消" Click="CancelCurrent_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="WorkspaceRoot" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <CommandBar DefaultLabelPosition="Right" Background="Transparent" IsOpen="False"
                            Margin="4,0,4,4">
                    <AppBarButton Label="刷新" Click="Refresh_Click">
                        <AppBarButton.Icon><SymbolIcon Symbol="Refresh" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="更新" Click="Update_Click">
                        <AppBarButton.Icon><SymbolIcon Symbol="Sync" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="提交" Click="Commit_Click">
                        <AppBarButton.Icon><SymbolIcon Symbol="Save" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="更多">
                        <AppBarButton.Icon><SymbolIcon Symbol="More" /></AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="刷新锁定状态（需要联网）" Click="RefreshLocks_Click" />
                                <MenuFlyoutItem Text="检查未完成的操作…" Click="ShowJournal_Click" />
                                <MenuFlyoutItem Text="Cleanup…" Click="Cleanup_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="关闭工作副本" Click="CloseWorkingCopy_Click" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <CommandBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="{x:Bind ViewModel.WorkingCopyName, Mode=OneWay}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.WorkingCopyRevisionText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.StatusSummary, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </CommandBar.Content>
                </CommandBar>

                <NavigationView x:Name="Navigation" Grid.Row="1"
                                PaneDisplayMode="Left" OpenPaneLength="190"
                                IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                                SelectionChanged="Navigation_SelectionChanged">
                    <NavigationView.MenuItems>
                        <NavigationViewItem x:Name="ChangesItem" Content="变更" Tag="changes">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="历史" Tag="history">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Name="PropertiesItem" Content="属性" Tag="properties">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="Tag" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="信息" Tag="info">
                            <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                    <Frame x:Name="ContentFrame" />
                </NavigationView>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Padding="12,6" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind VersionText}" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentTaskDetail, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="720" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="取消" Click="CancelCurrent_Click"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="任务" Click="ShowTasks_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
