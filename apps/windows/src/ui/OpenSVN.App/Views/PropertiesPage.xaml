<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenSVN.App.Views.PropertiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSVN.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="PropertyTemplate" x:DataType="local:PropertyRow">
            <Grid Padding="4,7" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ValuePreview}" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind DisplayPath}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <FontIcon Grid.Column="1" Glyph="&#xE72E;" FontSize="12"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Visibility="{x:Bind ReservedVisibility}" VerticalAlignment="Center"
                          ToolTipService.ToolTip="svn 内部属性"
                          AutomationProperties.Name="SVN 内部属性" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16,8,16,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="属性" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock x:Name="TargetText" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <CheckBox x:Name="RecursiveCheck" Content="包含子目录"
                          Checked="Recursive_Changed" Unchecked="Recursive_Changed" />
                <ProgressRing x:Name="LoadingRing" Width="18" Height="18" IsActive="False"
                              AutomationProperties.Name="正在加载属性" />
                <Button Content="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <ListView x:Name="PropertyList" ItemTemplate="{StaticResource PropertyTemplate}"
                              SelectionMode="Single" SelectionChanged="PropertyList_SelectionChanged" />
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="没有属性" FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="可以在右侧新增一个属性。" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="属性编辑器" FontWeight="SemiBold" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="属性修改会先写入本地工作副本，直到下次提交才影响仓库。删除属性可以用还原撤销。" />
                        <TextBox x:Name="NameBox" Header="名称"
                                 PlaceholderText="例如 svn:ignore 或 custom:value" />
                        <TextBox x:Name="ValueBox" Header="值"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="150" MaxHeight="300"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="svn:ignore 每行一个模式；留空的行会被忽略。属性名不能为空。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ApplyButton" Content="应用" Style="{StaticResource AccentButtonStyle}"
                                    Click="Apply_Click" />
                            <Button x:Name="DeleteButton" Content="删除属性" Click="Delete_Click"
                                    IsEnabled="False" />
                            <Button Content="新建属性" Click="New_Click" />
                        </StackPanel>
                        <TextBlock x:Name="EditorStatus" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
