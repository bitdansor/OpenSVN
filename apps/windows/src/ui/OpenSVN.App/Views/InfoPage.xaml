<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenSVN.App.Views.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSVN.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="InfoRowTemplate" x:DataType="local:InfoRow">
            <Grid Padding="0,6" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16,8,16,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="信息" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="来自本地工作副本的 svn info；这不能证明服务器当前可达。"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="LoadingRing" Width="18" Height="18" IsActive="False"
                              AutomationProperties.Name="正在加载工作副本信息" />
                <Button Content="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="ErrorBar" Grid.Row="1" Severity="Error" IsOpen="False"
                 IsClosable="True" Title="信息加载失败" Message="" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border CornerRadius="6" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="20">
                    <ItemsControl x:Name="InfoList" ItemTemplate="{StaticResource InfoRowTemplate}" />
                </Border>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Spacing="6"
                            Visibility="Collapsed" Margin="0,40,0,0">
                    <TextBlock Text="没有可显示的信息" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="请确认工作副本仍然存在并可读。" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
