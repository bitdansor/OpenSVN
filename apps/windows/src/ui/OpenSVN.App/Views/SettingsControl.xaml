<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenSVN.App.Views.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OpenSVN.App.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="CredentialTemplate" x:DataType="models:CredentialScopeDto">
            <Grid Padding="4,4" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="删除" Padding="10,3" FontSize="12"
                        Tag="{x:Bind StorageKey}" Click="DeleteCredential_Click" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Text="Subversion 工具链" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="留空表示自动查找：PATH、常见安装位置和 TortoiseSVN / VisualSVN / SlikSvn。OpenSVN 不会自动升级 svn 或工作副本。" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SvnPathBox" PlaceholderText="C:\Program Files\Subversion\bin\svn.exe" />
                <Button Grid.Column="1" Content="浏览…" Click="BrowseSvn_Click" />
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox x:Name="TimeoutBox" Header="操作超时（秒）" Minimum="5" Maximum="3600"
                           SpinButtonPlacementMode="Compact" Width="170" />
                <ToggleSwitch x:Name="AutoPreviewToggle" Grid.Column="1" Header="更新前显示远端预览"
                              OnContent="开启" OffContent="关闭" IsOn="True" />
            </Grid>
            <TextBlock x:Name="InstallationText" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SaveButton" Content="保存并重新连接" Style="{StaticResource AccentButtonStyle}"
                        Click="Save_Click" />
                <TextBlock x:Name="SaveStatus" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <StackPanel Spacing="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="已保存的凭据" FontWeight="SemiBold" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="刷新" Padding="10,3" FontSize="12" Click="RefreshCredentials_Click" />
                    <Button x:Name="ClearCredentialsButton" Content="清除全部" Padding="10,3" FontSize="12"
                            Click="ClearCredentials_Click" />
                </StackPanel>
            </Grid>
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="密码按协议、主机、端口和 realm 隔离存放在 Windows 凭据管理器；这里不会读取或显示密码。删除单个凭据不需要确认。" />
            <TextBlock x:Name="CredentialHint" FontSize="12"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <Border CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    MinHeight="92" MaxHeight="200">
                <Grid>
                    <ListView x:Name="CredentialsList" ItemTemplate="{StaticResource CredentialTemplate}"
                              SelectionMode="None" />
                    <TextBlock x:Name="NoCredentialsText" Text="没有保存的凭据"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>

        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <StackPanel Spacing="6">
            <TextBlock Text="数据位置" FontWeight="SemiBold" />
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="操作日志、冲突备份和设置保存在本机应用数据目录，不会上传到仓库。" />
            <TextBlock x:Name="DataDirectoryText" FontSize="12"
                       FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap"
                       IsTextSelectionEnabled="True" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="打开数据目录" Click="OpenDataDirectory_Click" />
                <Button x:Name="JournalButton" Content="检查未完成操作…" Click="Journal_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
