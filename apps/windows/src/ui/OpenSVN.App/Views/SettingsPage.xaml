<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenSVN.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OpenSVN.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,8,16,20" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="这些设置只影响本机；仓库和凭据都不会被写入工作副本。"
                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <views:SettingsControl />
        </StackPanel>
    </ScrollViewer>
</Page>
