<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenSVN.App.Views.ChangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OpenSVN.App.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedSource" IsSourceGrouped="True" />
        <DataTemplate x:Key="StatusItemTemplate" x:DataType="models:StatusItem">
            <Grid Padding="6,7" ColumnSpacing="10">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="复制完整路径" Tag="{x:Bind Path}"
                                        Click="CopyPath_Click" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="4"
                        Background="{x:Bind BadgeColor, Converter={StaticResource StringToBrush}}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Badge}" Foreground="White" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind DisplayPath}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Path}"
                               AutomationProperties.Name="{x:Bind Path}" />
                    <TextBlock Text="{x:Bind ConflictText}" FontSize="12"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind HasConflictFlags, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind ItemLabel}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="3" CornerRadius="4" Padding="6,2"
                        Background="{x:Bind LockColor, Converter={StaticResource StringToBrush}}"
                        VerticalAlignment="Center" AutomationProperties.Name="{x:Bind LockTooltip}"
                        Visibility="{x:Bind HasLock, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="锁" Foreground="White" FontSize="11" />
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16,8,16,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="变更" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.StatusSummary, Mode=OneWay}"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <AutoSuggestBox x:Name="FilterBox" Grid.Column="1" Width="320"
                            PlaceholderText="过滤路径（空格分隔，全部命中）"
                            QueryIcon="Find" TextChanged="FilterBox_TextChanged" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4">
            <InfoBar x:Name="ConflictBanner" Severity="Warning" IsClosable="False"
                     Title="存在未解决的冲突"
                     Message="含冲突的文件不会被提交。请选择冲突项并解决后再提交。" />
            <InfoBar x:Name="StatusErrorBar" Severity="Error" IsClosable="True" IsOpen="False"
                     Title="无法读取工作副本状态" Message="" />
        </StackPanel>

        <CommandBar Grid.Row="2" DefaultLabelPosition="Right" IsOpen="False" Background="Transparent">
            <AppBarButton x:Name="AddButton" Label="加入" Click="Add_Click" IsEnabled="False">
                <AppBarButton.Icon><SymbolIcon Symbol="Add" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="DeleteButton" Label="删除" Click="Delete_Click" IsEnabled="False">
                <AppBarButton.Icon><SymbolIcon Symbol="Delete" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="RevertButton" Label="还原" Click="Revert_Click" IsEnabled="False">
                <AppBarButton.Icon><SymbolIcon Symbol="Undo" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ResolveButton" Label="解决冲突…" Click="Resolve_Click" IsEnabled="False">
                <AppBarButton.Icon><SymbolIcon Symbol="Accept" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="LockButton" Label="锁定…" Click="Lock_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE72E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="UnlockButton" Label="解除锁定" Click="Unlock_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE785;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="IgnoreButton" Label="忽略…" Click="Ignore_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8D8;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="PropertiesButton" Label="属性…" Click="Properties_Click" IsEnabled="False">
                <AppBarButton.Icon><SymbolIcon Symbol="Tag" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="DiffButton" Label="差异" Click="Diff_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8A5;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="3">
            <ListView x:Name="StatusList" AutomationProperties.Name="工作副本变更"
                      SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False"
                      SelectionChanged="StatusList_SelectionChanged"
                      DoubleTapped="StatusList_DoubleTapped"
                      ItemTemplate="{StaticResource StatusItemTemplate}">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="6,12,0,4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CountText}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>

            <StackPanel x:Name="CleanState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE73E;" FontSize="36"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="工作副本干净" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock Text="没有已修改、新增、删除或未纳入版本控制的路径。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="NoResultsState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE721;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="没有匹配的路径" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock Text="过滤只影响显示，不会改变工作副本的状态。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="CountText" Grid.Row="4" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="6,2,0,0" />
    </Grid>
</Page>
